    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: ERNIE VL OCR2Ernie",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
        },

        {
            "name": "Python Debugger: ERNIE OCR Training Single GPU",
            "type": "debugpy",
            "request": "launch",
            // "program": "${file}",
            // "module": "paddle.distributed.launch",
            "module": "erniekit.cli",
            // "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "nnodes": "1",
                "nproc_per_node": "1",
                "CUDA_VISIBLE_DEVICES": "6",
                "NPROC_PER_NODE": "1",
            },
            "args": [
                    "train", "examples/configs/ERNIE-4.5-0.3B/sft/run_ocr_sft_8k.yaml",
                    "model_name_or_path=/root/paddlejob/workspace/env_run/laipeiwen/PaddleOCR-SFT-Model-0913",
                    "train_dataset_path=/root/paddlejob/workspace/env_run/laipeiwen/dataformat_transform/OCR/ocrv5_train_ernie_choose_sft_0808_mini.jsonl", "train_dataset_prob=1.0",
                    "multimodal=true", "max_seq_len=1024",
                    // "tensor_parallel_degree=1", "pipeline_parallel_degree=2",
                    // "pp_need_data=true", "pp_need_data_degree=2",
                    "overwrite_output_dir=1"
                ]
        },

        {
            "name": "Python Debugger: ERNIE OCR Training",
            "type": "debugpy",
            "request": "launch",
            // "program": "${file}",
            // "module": "paddle.distributed.launch",
            "module": "erniekit.cli",
            // "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "nnodes": "1",
                "nproc_per_node": "2",
                "CUDA_VISIBLE_DEVICES": "6,7",
                "NPROC_PER_NODE": "2",
                "FLAGS_embedding_deterministic": "1",
                "FLAGS_cudnn_deterministic": "1",
            },
            "args": [
                    "train", "examples/configs/ERNIE-4.5-0.3B/sft/run_ocr_sft_8k.yaml",
                    // "model_name_or_path=/root/paddlejob/workspace/env_run/laipeiwen/PaddleOCR-SFT-Model-0913",
                    // "model_name_or_path=/root/paddlejob/workspace/env_run/laipeiwen/PaddleOCR-SFT-Model-0913-pd",
                    "model_name_or_path=/root/paddlejob/workspace/env_run/laipeiwen/PaddleOCR-PT-Model-25026-pd",
                    // "train_dataset_path=/root/paddlejob/workspace/env_run/laipeiwen/dataformat_transform/OCR/ocrv5_train_ernie_choose_sft_0808_mini.jsonl", "train_dataset_prob=1.0",
                    "train_dataset_path=/root/paddlejob/workspace/env_run/laipeiwen/sft0908_for_ernie_style_mini/ppocrvl_lhe_exp2_7_60w.jsonl,/root/paddlejob/workspace/env_run/laipeiwen/sft0908_for_ernie_style_mini/ocr_sft_0909.jsonl,/root/paddlejob/workspace/env_run/laipeiwen/sft0908_for_ernie_style_mini/table_filtered.jsonl", "train_dataset_prob=0.2204724409448819,0.3779527559055118,0.4015748031496063",
                    "multimodal=true", "max_seq_len=16384", "use_flash_attention=True", "recompute=True", "gradient_accumulation_steps=2",
                    // "tensor_parallel_degree=1", "pipeline_parallel_degree=2",
                    // "pp_need_data=true", "pp_need_data_degree=2",
                    "overwrite_output_dir=1"
                ]
        },

        {
            "name": "Python Debugger: ERNIE VL SFT Continuous Training",
            "type": "debugpy",
            "request": "launch",
            // "program": "${file}",
            // "module": "paddle.distributed.launch",
            "module": "erniekit.cli",
            // "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {
                "nnodes": "1",
                "CUDA_VISIBLE_DEVICES": "4,5,6,7",
            },
            "args": [
                    "train", "examples/configs/ERNIE-4.5-VL-28B-A3B/sft/run_sft_8k.yaml",
                    "model_name_or_path=/root/paddlejob/workspace/env_run/laipeiwen/ERNIE-4.5-VL-28B-A3B-Paddle",
                    // "train_dataset_path=examples/data/sft_vl-train_demo1.jsonl", "train_dataset_prob=1.0",
                    "train_dataset_path=/root/paddlejob/workspace/env_run/laipeiwen/dataformat_transform/OCR/ocrv5_train_ernie_choose_sft_0808.jsonl", "train_dataset_prob=1.0","tensor_parallel_degree=2", "pipeline_parallel_degree=2",
                    "pp_need_data=true", "pp_need_data_degree=2",
                ]
        },

        {
            "name": "Python Debugger: ERNIE VL SFT Training",
            "type": "debugpy",
            "request": "launch",
            // "program": "${file}",
            "module": "paddle.distributed.launch",
            // "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": ["--log_dir", "output/paddle_distributed_logs",
                    "--nnodes", "1",
                    "--rank", "0",
                    "--run_mode=collective",
                    "examples/post-training/vl_sft/train.py",
                    "--from_scratch", "0",
                    "--vit_lr_ratio", "0.9",
                    "--freeze_config", "freeze_vision",
                    "--multimodal", "true",
                    "--model_name_or_path", "/root/paddlejob/workspace/env_run/laipeiwen/ERNIE-4.5-VL-28B-A3B-Paddle",
                    "--output_dir", "./output/laipeiwen_output_dir",
                    "--data_load_process_num", "1",
                    "--max_seq_length", "8192",
                    "--pad_to_max_seqlen", "8192",
                    "--base_seq_length", "8192",
                    "--variable_resolution", "1",
                    "--global_shuffle_num_examples", "1000000",
                    "--sequence_parallel", "1",
                    "--moe_use_aux_free_update_coef", "0.0",
                    // "--train_dataset_path", "examples/data/sft_vl-train_demo1.jsonl,examples/data/sft_vl-train_demo2.jsonl",
                    "--train_dataset_path", "/root/paddlejob/workspace/env_run/laipeiwen/dataformat_transform/NeXTVideo2ERNIE/ERNIE/train.jsonl,/root/paddlejob/workspace/env_run/laipeiwen/dataformat_transform/NeXTVideo2ERNIE/ERNIE/train.jsonl",
                    "--train_dataset_prob", "0.5,0.5",
                    "--visual_ld", "0.9",
                    "--modality_ratio", "[1,1]",
                    "--moe_gate_lr_ratio", "0.01",
                    "--dataloader_num_workers", "1",
                    "--dataset_name", "KnowledgeBasedSFTReader",
                    "--add_sys_token", "true",
                    "--number_of_samples_each_epoch", "10000000",
                    "--trigger_data_prob", "1.0",
                    "--drop_history_with_k", "true",
                    "--prefetch_factor", "4",
                    "--one_sample_in_one_seq", "true",
                    "--use_multi_image_crop", "true",
                    "--serialize_output", "false",
                    "--chat_template", "deepseek",
                    "--render_timestamp", "true",
                    "--pp_need_data", "true",
                    // "--adam_beta1", "0.9",
                    "--adam_beta2", "0.95",
                    "--bf16", "true",
                    "--do_train", "true",
                    "--fp16_opt_level", "O2",
                    "--global_batch_size", "8",
                    "--learning_rate", "1e-05",
                    "--logging_steps", "1",
                    "--lr_scheduler_type", "cosine",
                    "--max_steps", "1",
                    "--save_steps", "100",
                    "--min_lr", "1e-06",
                    "--same_data", "true",
                    "--load_sharded_model", "true",
                    "--save_sharded_model", "true",
                    "--scale_loss", "4096",
                    "--warmup_steps", "1",
                    "--weight_decay", "0.1",
                    "--overwrite_output_dir", "1",
                    "--per_device_eval_batch_size", "1",
                    "--per_device_train_batch_size", "1",
                    "--pp_need_data_degree", "2",
                    "--pipeline_parallel_degree", "2",
                    "--tensor_parallel_degree", "4",
                    "--amp_master_grad", "1",
                    "--pipeline_parallel_config", "enable_offload_queue enable_delay_scale_loss enable_overlap_p2p_comm best_unbalanced_scheduler",
                    "--sharding_parallel_config", "split_param enable_fuse_optimizer_states",
                    "--tensor_parallel_config", "sync_param sync_grad sync_moment",
                    "--pre_alloc_memory", "30",
                    "--sharding_comm_buffer_size_MB", "512",
                    "--use_moe", "true",
                    "--moe_group", "mp",
                    "--gc_interval", "100000",
                    "--skip_profile_timer", "0",
                    "--save_sharding_stage1_model_include_freeze_params", "true",
                    "--disable_pipeline_warmup", "true"
                ]
        }
    ]
}